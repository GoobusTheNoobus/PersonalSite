---
import Layout from '../layouts/Layout.astro';
import { ASCII_ART } from '../global.ts';
---

<Layout title="Goobus' Personal Site">
  <main>
    <div class="hero">
      <pre class="ascii-art" aria-hidden="true">{ASCII_ART}</pre>
      <p class="subtitle">
        Unemployed Larper Larping Code
        <span class="cursor" aria-hidden="true">
          _
        </span>
      </p>
    </div>

    <div class="cards">
      <div class="card" id="hello-card">
        <h2>Hello! :D</h2>
        <p>
          I'm David, and I am a hobbyist programmer who likes building random
          stuff. Most of my free time goes toward playing chess, drawing, and
          working on coding projects (like this one!).
        </p>
      </div>

      <div class="card" id="about-card">
        <h2>About me</h2>

        <ul>
          <li>Pronouns: He/Him</li>
          <li>I prefer understanding my code over blindly copying solutions</li>
          <li>
            I am against the use of LLM generated code in my projects, as I
            accomplish nothing that way
          </li>
          <li>
            <strong>Philippians 4:13</strong>
            <i>"I can do all things through him who strengthens me."</i>
          </li>
        </ul>
      </div>

      <div class="card" id="technologies">
        <h2>Technologies</h2>
        <i>
          I'm still learning, these technologies are just the ones I have at
          least a bit of experience with.
        </i>
      </div>

      <div class="card" id="languages-card">
        <h2>Languages</h2>

        <ul>
          <li>C++</li>
          <li>Python</li>
          <li>HTML/CSS/TypeScript</li>
          <li>Java</li>
          <li>C#</li>
        </ul>
      </div>

      <div class="card" id="tools-card">
        <h2>Tools</h2>

        <ul>
          <li>Git/Github</li>
          <li>Linux</li>
          <li>Visual Studio Code</li>
          <li>CLion</li>
          <li>PyCharm</li>
          <li>Vite</li>
          <li>Astro</li>
        </ul>
      </div>
    </div>
  </main>

  <style>
    .hero {
      width: fit-content;
      max-width: 100%;
      margin: 2rem auto 5rem;
      display: flex;
      flex-direction: column;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      user-select: none;
      color: rgb(191, 218, 210);
    }

    .ascii-art {
      font-size: clamp(0.35rem, 1.5vw, 1rem);
      line-height: 1.15;
      overflow-x: auto;
    }

    .subtitle {
      margin: 0;
      font-size: clamp(0.8rem, 1.2vw, 1.25rem);
      letter-spacing: 0.08em;
    }

    .subtitle::before {
      content: '$ ';
    }

    .cards {
      display: flex;
      flex-wrap: wrap;
      width: 70vw;
      padding: 1rem;

      margin: 0 auto 3rem;

      background-color: rgba(25, 48, 70, 0.08);

      border-radius: 2rem;
      border-width: 2px;
      border-color: rgb(51, 49, 56);
      border-style: solid;
    }

    .card {
      padding: 1rem 2rem 1rem;
      background-color: rgba(25, 48, 70, 0.08);

      border-radius: 2rem;
      border-width: 2px;
      border-color: rgb(51, 49, 56);
      border-style: solid;

      margin: 0.5rem auto 0.5rem;

      transition: 150ms ease;
    }

    .card:hover {
      border-color: var(--color-bright);
      background-color: rgba(25, 48, 70, 0.2);
    }

    #about-card {
      width: 36%;
    }

    #hello-card {
      width: 50%;
    }

    #technologies {
      width: 93%;
      text-align: center;
    }

    #languages-card {
      width: 42%;
    }

    #tools-card {
      width: 44%;
    }
  </style>
</Layout>
