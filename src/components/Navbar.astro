---
import '../styles/global.css';
import { ASCII_ART } from '../global';
const base = import.meta.env.BASE_URL;
---

<nav>
  <a class='ascii-art' href={base}>
    <pre>{ASCII_ART}</pre>
  </a>
  <div class="nav-links">
    <a href={base}>Home</a>
    <a href={base + '/projects'}>Projects</a>
    <a
      href="https://github.com/GoobusTheNoobus/PersonalSite"
      target="_blank"
      rel="noopener noreferrer"
    >
      Repo ↗
    </a>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 1rem;
    z-index: 1000;

    display: flex;
    margin: 3rem 10rem 1rem;
    padding: 1rem 4rem;
    min-height: 4rem;
    align-items: center;

    background-color: rgba(68, 72, 77, 0.4);

    border-radius: 2rem;
    border-width: 2px;
    border-color: rgb(51, 49, 56);
    border-style: solid;
  }

  .nav-links {
    display: flex;
    gap: 3rem;
    margin-left: auto;
  }

  .ascii-art {
    font-size: 0.3rem;
    line-height: 0.3rem;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    nav {
      margin: 1.5rem 1rem;
      padding: 1rem;
      gap: 1rem;
    }

    nav pre {
      font-size: 0.2rem;
    }

    .nav-links {
      gap: 1rem;
    }

    .nav-links a {
      font-size: 0.9rem;
      
    }
  }
</style>
